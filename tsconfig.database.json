{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist-db",
    "noEmit": false,
    "target": "ES2020"
  },
  "include": [
    "database/**/*.ts",
    "src/**/*.ts"
  ],
  "exclude": ["node_modules", "app", "components", "lib"]
}
